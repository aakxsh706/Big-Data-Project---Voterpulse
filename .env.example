# Copy to .env (optional). Every value here has a safe default in config/*.yaml.
# No API keys or secrets are needed by VoterPulse Lite.

# Path to the live SQLite database (relative paths resolve from the project root).
VOTERPULSE_DB_PATH=data/voterpulse.db

# Set to 1 to point the dashboard at the separate synthetic demo database.
VOTERPULSE_DEMO_MODE=0

# Local Ollama server and model tag.
VOTERPULSE_OLLAMA_HOST=http://localhost:11434
VOTERPULSE_MODEL=llama3.2:3b

# DEBUG, INFO, WARNING, ERROR
VOTERPULSE_LOG_LEVEL=INFO

# MongoDB + Apache Spark profile. Start MongoDB before enabling automatic sync.
VOTERPULSE_BIG_DATA_ENABLED=0
VOTERPULSE_MONGO_URI=mongodb://127.0.0.1:27017
VOTERPULSE_MONGO_DATABASE=voterpulse
VOTERPULSE_MONGO_DEMO_DATABASE=voterpulse_demo
VOTERPULSE_SPARK_MASTER=local[*]
VOTERPULSE_SPARK_PARTITIONS=4
